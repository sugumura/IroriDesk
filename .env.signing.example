# macOS の署名・公証の設定（scripts/release-mac.sh が読み込む）
# このファイルを .env.signing にコピーして値を入れる。.env.signing はコミットしない

# キーチェーンに入れた「Developer ID Application」証明書の名前
#   確認: security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# 公証の認証情報。A か B のどちらかを設定する

# A. App Store Connect API キー（推奨）
#   App Store Connect > ユーザとアクセス > 統合 > App Store Connect API で作成
APPLE_API_ISSUER=""
APPLE_API_KEY=""
APPLE_API_KEY_PATH=""   # ダウンロードした AuthKey_XXXX.p8 の絶対パス

# B. Apple ID と App 用パスワード
#   App 用パスワードは account.apple.com > サインインとセキュリティ で発行
APPLE_ID=""
APPLE_PASSWORD=""
APPLE_TEAM_ID=""
